{
  "name": "ArtistAssistApp",
  "short_name": "ArtistAssistApp",
  "icons": [
    {
      "src": "/assets/favicon/pwa-192x192.png?v=20260627",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/assets/favicon/pwa-512x512.png?v=20260627",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/assets/favicon/pwa-maskable-192x192.png?v=20260627",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/assets/favicon/pwa-maskable-512x512.png?v=20260627",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "start_url": "/",
  "display": "standalone",
  "background_color": "#ffffff",
  "theme_color": "#1890ff",
  "description": "Mix any color from a reference photo with the paints you own. Outlines, grids, tonal values, limited palettes, and photo editing.",
  "screenshots": [
    {
      "src": "/assets/screenshots/wide/color-picker.webp",
      "sizes": "1280x800",
      "type": "image/webp",
      "form_factor": "wide",
      "label": "Mix any color from a reference photo with the paints you own"
    },
    {
      "src": "/assets/screenshots/wide/2-color-gradient.webp",
      "sizes": "1280x800",
      "type": "image/webp",
      "form_factor": "wide",
      "label": "Compare mixing ratios and consistencies with two-color gradients"
    },
    {
      "src": "/assets/screenshots/wide/tonal-values.webp",
      "sizes": "1280x800",
      "type": "image/webp",
      "form_factor": "wide",
      "label": "Study tonal values to check contrast in your photo"
    },
    {
      "src": "/assets/screenshots/wide/outline.webp",
      "sizes": "1280x800",
      "type": "image/webp",
      "form_factor": "wide",
      "label": "Turn a photo into a clean outline to trace"
    },
    {
      "src": "/assets/screenshots/narrow/color-picker.webp",
      "sizes": "720x1599",
      "type": "image/webp",
      "form_factor": "narrow",
      "label": "Mix any color from a reference photo with the paints you own"
    },
    {
      "src": "/assets/screenshots/narrow/2-color-gradient.webp",
      "sizes": "720x1599",
      "type": "image/webp",
      "form_factor": "narrow",
      "label": "Compare mixing ratios and consistencies with two-color gradients"
    },
    {
      "src": "/assets/screenshots/narrow/tonal-values.webp",
      "sizes": "720x1599",
      "type": "image/webp",
      "form_factor": "narrow",
      "label": "Study tonal values to check contrast in your photo"
    },
    {
      "src": "/assets/screenshots/narrow/outline.webp",
      "sizes": "720x1599",
      "type": "image/webp",
      "form_factor": "narrow",
      "label": "Turn a photo into a clean outline to trace"
    }
  ],
  "categories": ["art", "drawing", "painting", "design", "education", "graphics"],
  "lang": "en",
  "orientation": "any",
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "shared_files",
          "accept": ["image/*", ".clrb", "application/json", ".artistassist", "application/zip"]
        }
      ]
    }
  },
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "handle_links": "preferred"
}
