{
  "name": "artistassistapp",
  "version": "2026.11.9",
  "type": "module",
  "scripts": {
    "lingui:extract": "lingui extract --clean",
    "translate": "tsx translate-po.ts",
    "dev": "BUILD_ID=$(date +%s) vite",
    "build": "tsc -b && BUILD_ID=$(date +%s) vite build",
    "build:dev": "npm run build -- --mode development",
    "preview": "vite preview",
    "clean": "rm -rf node_modules/.vite dist",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --check",
    "format:write": "prettier . --write",
    "type-check": "tsc --noEmit",
    "test": "npm run type-check && npm run lint && npm run format && npm run test:unit",
    "test:unit": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "coverage": "vitest run --coverage",
    "prepare": "husky"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@eugene-khyst/artistassistapp-color-mixer": "^4.2.0",
    "@eugene-khyst/artistassistapp-image-processing": "^2.1.0",
    "@fontsource/kalam": "^5.3.0",
    "@lingui/core": "^6.12.0",
    "@lingui/react": "^6.12.0",
    "@tanstack/react-query": "^5.107.1",
    "antd": "^6.7.0",
    "clsx": "^2.1.1",
    "comlink": "^4.4.2",
    "dayjs": "^1.11.23",
    "fflate": "^0.8.3",
    "file-saver": "^2.0.5",
    "html-to-image": "^1.11.13",
    "idb": "^8.0.4",
    "jose": "^6.2.16",
    "mime": "^4.1.2",
    "onnxruntime-web": "^1.31.1",
    "print-js": "^1.6.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-dropzone": "^20.2.0",
    "react-error-boundary": "^6.1.6",
    "react-sticky-box": "^2.0.5",
    "react-string-replace": "^2.0.1",
    "react-to-print": "^3.3.0",
    "valibot": "^1.5.0",
    "whatwg-mimetype": "^5.0.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.28.8",
    "@eslint/config-helpers": "^0.7.0",
    "@eslint/js": "^10.0.1",
    "@lingui/cli": "^6.12.0",
    "@lingui/swc-plugin": "^6.7.1",
    "@lingui/vite-plugin": "^6.12.0",
    "@types/file-saver": "^2.0.7",
    "@types/gettext-parser": "^9.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/whatwg-mimetype": "^5.0.0",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "@vitest/browser": "^4.1.12",
    "@vitest/browser-playwright": "^4.1.12",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^10.14.0",
    "eslint-plugin-import-x": "^4.18.1",
    "eslint-plugin-license-header": "^0.9.0",
    "eslint-plugin-lingui": "^0.16.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
